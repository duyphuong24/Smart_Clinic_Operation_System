<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="dialog-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <VBox spacing="2.0">
            <Label styleClass="dialog-title" text="Invoice Details" />
            <Label fx:id="invoiceNumberLabel" styleClass="dialog-subtitle" text="-" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="statusBadge" styleClass="status-badge" text="-" />
    </HBox>

    <GridPane hgap="12.0" styleClass="dialog-details-grid" vgap="8.0">
        <columnConstraints>
            <ColumnConstraints minWidth="100.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="220.0" />
        </columnConstraints>

        <Label styleClass="detail-field-label" text="Patient" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label fx:id="patientLabel" styleClass="detail-field-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label styleClass="detail-field-label" text="Visit / Encounter" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Label fx:id="visitLabel" styleClass="detail-field-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label styleClass="detail-field-label" text="Issued At" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <Label fx:id="issuedAtLabel" styleClass="detail-field-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label styleClass="detail-field-label" text="Total Amount" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <Label fx:id="totalAmountLabel" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #0072ff;" text="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>

    <Label text="INVOICE LINE ITEMS" style="-fx-font-weight: bold; -fx-text-fill: #4b5563; -fx-font-size: 12px;" />

    <TableView fx:id="itemsTable" styleClass="data-table" prefHeight="180.0">
        <columns>
            <TableColumn fx:id="descColumn" prefWidth="200.0" text="Description" />
            <TableColumn fx:id="typeColumn" prefWidth="100.0" text="Type" />
            <TableColumn fx:id="qtyColumn" prefWidth="60.0" text="Qty" />
            <TableColumn fx:id="priceColumn" prefWidth="100.0" text="Unit Price" />
            <TableColumn fx:id="totalColumn" prefWidth="110.0" text="Line Total" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button onAction="#onClose" styleClass="btn-secondary" text="Close" />
    </HBox>
</VBox>
