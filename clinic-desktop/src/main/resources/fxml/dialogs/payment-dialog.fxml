<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="dialog-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>

    <Label styleClass="dialog-title" text="Record Payment" />
    <Label styleClass="dialog-subtitle" text="Process payment for the issued invoice." wrapText="true" />

    <Label fx:id="errorLabel" managed="false" styleClass="error-label" visible="false" />

    <GridPane hgap="12.0" styleClass="dialog-details-grid" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="130.0" prefWidth="130.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="240.0" />
        </columnConstraints>

        <Label styleClass="detail-field-label" text="Invoice Number" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label fx:id="invoiceNumberLabel" styleClass="detail-field-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label styleClass="detail-field-label" text="Patient" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Label fx:id="patientLabel" styleClass="detail-field-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label styleClass="detail-field-label" text="Total Amount Due" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <Label fx:id="totalAmountLabel" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #10b981;" text="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label styleClass="detail-field-label" text="Payment Method *" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <ComboBox fx:id="methodCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label styleClass="detail-field-label" text="Payment Amount *" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="amountField" promptText="Amount to pay" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label styleClass="detail-field-label" text="Transaction Ref" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="transactionRefField" promptText="e.g. TXN-98765" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <Label styleClass="detail-field-label" text="Note" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <TextField fx:id="noteField" promptText="Optional payment note" GridPane.columnIndex="1" GridPane.rowIndex="6" />
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <ProgressIndicator fx:id="loadingIndicator" managed="false" maxHeight="24.0" maxWidth="24.0" visible="false" />
        <Button onAction="#onCancel" styleClass="btn-secondary" text="Cancel" />
        <Button fx:id="confirmButton" defaultButton="true" onAction="#onConfirm" styleClass="btn-success" text="Confirm Payment" />
    </HBox>
</VBox>
