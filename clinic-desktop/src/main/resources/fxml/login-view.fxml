<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="loginRoot" styleClass="login-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartclinic.desktop.controller.LoginController">
    <VBox alignment="CENTER" spacing="0.0" StackPane.alignment="CENTER">
        <VBox alignment="CENTER" spacing="20.0" styleClass="login-card">
            <VBox alignment="CENTER" spacing="6.0">
                <Label styleClass="login-logo" text="Smart Clinic" />
                <Label styleClass="login-subtitle" text="Operations System" />
            </VBox>

            <Label fx:id="errorLabel" managed="false" styleClass="error-label" visible="false" wrapText="true" />

            <VBox spacing="8.0">
                <Label styleClass="form-label" text="USERNAME" />
                <TextField fx:id="userNameField" promptText="e.g. admin" />
            </VBox>

            <VBox spacing="8.0">
                <Label styleClass="form-label" text="PASSWORD" />
                <PasswordField fx:id="passwordField" promptText="Enter your password" />
            </VBox>

            <VBox spacing="8.0">
                <ProgressIndicator fx:id="loadingIndicator" managed="false" maxHeight="28.0" maxWidth="28.0" visible="false" />
                <Button fx:id="loginButton" defaultButton="true" maxWidth="Infinity" onAction="#onLogin" styleClass="btn-premium" text="Sign In" />
            </VBox>

            <Label styleClass="login-footer" text="Smart Clinic © 2026. All rights reserved." />
        </VBox>
    </VBox>
</StackPane>
