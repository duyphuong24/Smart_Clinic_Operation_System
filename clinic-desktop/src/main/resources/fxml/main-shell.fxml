<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="shell-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartclinic.desktop.controller.MainShellController">
    <left>
        <VBox styleClass="sidebar">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="24.0" />
            </padding>

            <Label styleClass="sidebar-brand" text="Smart Clinic">
                <VBox.margin>
                    <Insets bottom="24.0" left="8.0" />
                </VBox.margin>
            </Label>

            <VBox fx:id="sidebarMenu" spacing="6.0" VBox.vgrow="ALWAYS">
                <Button fx:id="homeMenuButton" maxWidth="Infinity" onAction="#onHome" styleClass="menu-button-active" text="Home" />
                <Button fx:id="appointmentsMenuButton" maxWidth="Infinity" onAction="#onAppointments" styleClass="menu-button" text="Today Appointments" />
                <Button fx:id="patientsMenuButton" maxWidth="Infinity" onAction="#onPatients" styleClass="menu-button" text="Patient Search" />
                <Button fx:id="queueMenuButton" maxWidth="Infinity" onAction="#onQueue" styleClass="menu-button" text="Queue Board" />
                <Button fx:id="invoicesMenuButton" maxWidth="Infinity" onAction="#onInvoices" styleClass="menu-button" text="Pending Invoices" />
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="sidebar-footer">
                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="userNameLabel" styleClass="user-name" text="User" />
                    <Label fx:id="userRoleLabel" styleClass="user-role" text="Role" />
                </VBox>
                <Button onAction="#onLogout" styleClass="btn-logout" text="Sign out" />
            </HBox>
        </VBox>
    </left>

    <center>
        <BorderPane>
            <top>
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="main-navbar">
                    <Label fx:id="pageTitleLabel" styleClass="page-title" text="Home" />
                </HBox>
            </top>
            <center>
                <StackPane fx:id="contentPane" styleClass="main-content" />
            </center>
        </BorderPane>
    </center>
</BorderPane>
