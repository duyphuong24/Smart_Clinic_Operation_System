# ==========================================
# CẤU HÌNH DATABASE SQL SERVER
# Hướng dẫn: Copy file này, đổi tên thành .env và điền thông tin thật vào
# ==========================================

# IP hoặc Domain của SQL Server (Ví dụ: localhost hoặc 192.168.1.xxx)
DB_HOST=localhost

# Cổng mặc định của SQL Server là 1433
DB_PORT=1433

# Tên database muốn kết nối
DB_NAME=ten_database_cua_ban_o_day

# Tài khoản SQL Server (Nên dùng user riêng, hạn chế dùng 'sa' trên Production)
DB_USER=sa

# Mật khẩu (KHÔNG ghi mật khẩu thật của Production vào file example này!)
DB_PASS=nhap_mat_khau_cua_ban_vao_day